<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Messages are read on demand when the user taps Scan, never in the background:
         there is no RECEIVE_SMS and no listener. What is read stays on the device. -->
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- One destination, one direction. INTERNET exists so the app can ask GitHub's
         public API whether a newer release has been published and download that APK if
         the user asks for it. Nothing is ever uploaded: no record, message, account,
         balance or figure is put in a request, and there is no analytics, no crash
         reporting and no backend of any kind. Both calls are in data/Updates.kt, which
         is the whole of the app's network code. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the app open Android's installer on an update the user chose to download.
         It installs nothing by itself: Android shows its own install screen, the user
         confirms, and the user must first allow it in system settings. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".RiyalApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Riyal"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Riyal.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares a downloaded update with the system installer, and only that. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
