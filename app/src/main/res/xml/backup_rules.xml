<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: the same as data_extraction_rules, nothing backed up by Android
     itself. Riyal has its own backup (Settings), and the records are built from the inbox. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
