<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone by Android's own backup or device transfer, as allowBackup
     "false" says for Android 11 and older: Riyal has its own backup (Settings), and the
     records are built from the inbox. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
