<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The five tabs (MainActivity's Tab), each a fragment that stays here once built.
         Every other page is an activity with a layout of its own, so the phone moves
         between them with its own transition. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Material 3 Expressive floating toolbar and its Add button, hovering over the
         content at the bottom centre rather than taking a row of its own. The tabs
         leave room for it at the end of their lists (toolbarSpace). -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/bottom_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" />

    <!-- The opening splash (LaunchSplash), over everything until the app has loaded;
         removed once it lifts. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/launch_splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

</FrameLayout>
