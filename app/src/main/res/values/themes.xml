<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Views-side theme: the window chrome of every activity. It sets no window
         animation, so moving between pages is the phone's own transition.
         Material 3 Expressive for XML from com.google.android.material:material:1.14.0.
         The screens themselves are Compose material3 1.5.0-alpha23 under MaterialExpressiveTheme. -->
    <style name="Theme.Riyal" parent="Theme.Material3Expressive.DayNight.NoActionBar" />

    <style name="Theme.Riyal.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- No icon: LaunchSplash draws the sign over this same background as soon as
             the app's first frame is up, so there is one opening rather than two. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.Riyal</item>
    </style>
</resources>
