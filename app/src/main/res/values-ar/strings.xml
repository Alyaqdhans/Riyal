        العربية تعدّ بستّ صيغ: صفر، واحد، اثنان، قلّة (٣-١٠)، كثرة (١١-٩٩)، ثم غير ذلك.
        Android يختار الصيغة من العدد نفسه.
    -->
    <plurals name="count_records">
        <item quantity="zero">لا سجلات</item>
        <item quantity="one">سجل واحد</item>
        <item quantity="two">سجلان</item>
