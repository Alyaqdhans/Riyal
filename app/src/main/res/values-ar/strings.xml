<?xml version="1.0" encoding="utf-8"?>
<!--
    كل ما يقوله التطبيق، بالعربية.

    Modern Standard Arabic, which is what Omani banking messages themselves use.
    A key missing from this file falls back to the English in values/strings.xml,
    so a partial translation degrades to English rather than to a crash.

    Terms to check before release - banking vocabulary is where a wrong word in a
    money app does real damage:
      expense    مصروف      (vs مصاريف / نفقة)
      income     دخل        (vs إيراد / وارد)
      transfer   تحويل      matches the word the banks' own SMS use
      merchant   المتجر     (vs التاجر - المتجر reads as the shop, التاجر as the person)
      account    حساب
      statement  كشف الحساب
-->
<resources>
    <!-- The app's own name stays as it is: it is the brand, and it is already Arabic. -->
    <string name="app_name">ريال</string>

